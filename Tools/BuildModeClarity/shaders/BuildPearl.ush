// Pixel-sized rounded pearl shell. Static thin-film colour, no scene sampling, blur or animation.
float2 size = 1.0 / max(float2(abs(ddx(UV.x)), abs(ddy(UV.y))), 0.00001);
if (Role > 5.5)
{
    float light = exp(-dot((UV-float2(.24,.65))*float2(1.5,1.2),(UV-float2(.24,.65))*float2(1.5,1.2))*3.0);
    float3 sea = lerp(float3(.28,.61,.77),float3(.77,.89,.91),smoothstep(0.0,.8,UV.y));
    sea = lerp(sea,float3(1.0,.94,.81),light*.66);
    float wave = sin(UV.x*8.0+UV.y*4.0)*.013 + sin(UV.x*17.0-UV.y*3.0)*.004;
    sea += wave*smoothstep(.4,1.0,UV.y);
    float hatch = .5+.5*sin((UV.x*size.x+UV.y*size.y)*1.3);
    sea += hatch*.009;
    float2 cell=floor(UV*float2(16,10));
    float seed=frac(sin(dot(cell,float2(127.1,311.7)))*43758.5453);
    float2 local=frac(UV*float2(16,10))-.5;
    float confetti=(1.0-smoothstep(.02,.042,abs(local.x)+abs(local.y)))*step(.90,seed);
    sea=lerp(sea,float3(1.0,.89,.59),confetti*.44);
    return float4(sea,1.0);
}
float radius = min(Role > 1.5 && Role < 2.5 ? 32.0 : 22.0, min(size.x, size.y) * 0.49);
float2 q = abs((UV - 0.5) * size) - (size * 0.5 - radius);
float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
float mask = 1.0 - smoothstep(-0.85, 0.85, d);
float rim = smoothstep(-3.0, -1.0, d) * mask;
float filmPhase = UV.x * 4.0 + UV.y * 2.0;
float3 film = 0.65 + 0.22 * cos(filmPhase + float3(0.0, 2.094, 4.188));
float3 base = lerp(float3(0.89, 0.91, 0.95), float3(0.97, 0.97, 1.0), 1.0 - UV.y);
float opacity = 0.79;
if (Role > 0.5 && Role < 1.5) { base = lerp(float3(0.81, 0.83, 0.9), float3(0.96, 0.97, 1.0), 1.0-UV.y); opacity = 0.97; }
if (Role > 1.5 && Role < 2.5) { base = lerp(float3(0.075,0.075,0.12),float3(0.11,0.105,0.155),1.0-UV.y); opacity = 0.94; }
if (Role > 2.5 && Role < 3.5) { base = lerp(float3(0.085,0.34,0.84),float3(0.035,0.12,0.49),1.0-UV.y); opacity = 0.99; }
float3 color = base + film * (0.018 * sin(UV.x*4.0 + UV.y*3.0));
color = lerp(color, lerp(float3(0.85,0.96,1.0),film,0.3), rim * 0.72);
if (Role > 4.5)
{
    float2 p=UV*size;
    float edgeY=min(p.y,size.y-p.y), edgeX=min(p.x,size.x-p.x);
    float cutY=length(float2((frac(p.x/21.0)-.5)*21.0,edgeY));
    float cutX=length(float2((frac(p.y/21.0)-.5)*21.0,edgeX));
    mask*=smoothstep(3.0,4.2,cutY)*smoothstep(3.0,4.2,cutX);
    return float4(float3(.98,.985,1.0),mask);
}
if (Role > 3.5) return float4(lerp(float3(0.25,0.78,1.0),film,0.22),rim * 0.94);
return float4(color, mask * opacity);
