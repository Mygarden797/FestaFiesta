{
    "mcpServers":  {
                       "blender":  {
                                       "command":  "blender-mcp",
                                       "args":  [
                                                    "--transport",
                                                    "stdio"
                                                ]
                                   },
                       "tripo":  {
                                     "command":  "cmd",
                                     "args":  [
                                                  "/c",
                                                  "npx",
                                                  "-y",
                                                  "tripo-cli@0.7.2",
                                                  "mcp"
                                              ],
                                     "env":  {
                                                 "TRIPO_NO_UPDATE_CHECK":  "1"
                                             }
                                 },
                       "meshy":  {
                                     "command":  "cmd",
                                     "args":  [
                                                  "/c",
                                                  "npx",
                                                  "-y",
                                                  "@meshy-ai/meshy-mcp-server@0.6.6"
                                              ]
                                 }
                   }
}
