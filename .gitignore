# Visual Studio 2022 user specific files
.vs/
.vsconfig

# Jetbrain Rider
.idea/
*.sln.DotSettings.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa
Output
Engine/x64
Client/x64
.vs

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# 로컬 제작 원본·외부 원본 에셋. 가공 후 Unreal 에셋만 Content/에서 관리한다.
/SourceArt/

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Local EOS SDK credentials generated by Scripts/SetupEOSDev.ps1
Config/GeneratedEngine.ini
Config/GeneratedEngine.ini.*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Local validation, staging, and release outputs
/Artifacts/
/Temp/

# Prerequisites
*.d
.gstack/

# Public-data source files are large and may have redistribution restrictions.
# Keep the catalog in Git, but keep downloaded originals local.
data/raw/
data/extracted/

# 로컬 작업 기록이라 커밋에서 제외.
data/metadata/SiriKim_Docs/

# 로컬 전용 AI 컨텍스트 문서. 팀 공유 원본이 아니라 개인 작업 요약이라 커밋에서 제외.
/AGENTS.md
/CLAUDE.md
/docs/

# Cesium 플러그인은 용량이 커서 각자 GitHub 릴리스에서 받아 로컬에 설치
Plugins/CesiumForUnreal/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Python bytecode generated by facility authoring/verification scripts
__pycache__/
*.py[cod]
